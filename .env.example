# Configuration for Reto 3: Multi-Agent Topology Comparison
# Copy this file to .env and insert your real credentials.

# Primary LLM Gateways (choose at least one, or use simulation/local models)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LangSmith Observability and Cost Tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=reto3-multiagent-evaluation
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Default Model Selection
MODEL_WORKER=deepseek/deepseek-v4.1-flash
MODEL_ORCHESTRATOR=deepseek/deepseek-v4.1-flash
MODEL_STRONG=google/gemini-3.7-flash
MODEL_JUDGE=anthropic/claude-haiku-5.5
